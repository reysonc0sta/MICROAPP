# Use só se rodar o backend fora do Docker Compose.
# Copie:  copy .env.example .env  (Windows)  |  cp .env.example .env  (Linux/macOS)
# Com Compose, o .env da raiz é suficiente.

DATABASE_URL=postgresql://postgres:altere_esta_senha@localhost:5432/hub_escola
SECRET_KEY=gere_uma_chave_aleatoria_longa
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=altere_esta_chave
EVOLUTION_INSTANCE_NAME=altere

# Não coloque IP da LAN aqui — CORS_ALLOW_LAN cobre acesso pela rede local.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_LAN=true

ADMIN_EMAIL=admin@escola.com
ADMIN_PASSWORD=altere_esta_senha
