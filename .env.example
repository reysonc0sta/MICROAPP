# Copie para .env e preencha localmente. Não commite valores reais.

# PostgreSQL (o app e o docker-compose usam este dialect — não use mysql+pymysql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hub_escola
DATABASE_URL=postgresql://postgres:change-me@db:5432/hub_escola

# JWT — gere um valor local (ex.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Evolution API / WhatsApp
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=hub_escola

# CORS: origens explícitas, separadas por vírgula. Não use "*".
# Se acessar o frontend por IP da LAN, inclua essa origem (ex.: http://192.168.0.10:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap do usuário ADM na subida do backend (obrigatório no Docker Compose)
ADMIN_EMAIL=admin@escola.com
ADMIN_PASSWORD=change-me

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
