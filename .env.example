# Copie para .env na raiz:  copy .env.example .env  (Windows)  |  cp .env.example .env  (Linux/macOS)
# Não coloque IP da LAN em CORS — use CORS_ALLOW_LAN=true (o frontend resolve a API pelo host da página).

# Postgres (obrigatório para o Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_esta_senha
POSTGRES_DB=altere
# Host "db" = nome do serviço na rede Docker
DATABASE_URL=postgresql://postgres:altere_esta_senha@db:5432/altere

# Backend / JWT (obrigatório)
SECRET_KEY=gere_uma_chave_aleatoria_longa
ADMIN_EMAIL=admin@altere.com
ADMIN_PASSWORD=altere_esta_senha

# Evolution API / WhatsApp (obrigatório)
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=altere_esta_chave
EVOLUTION_INSTANCE_NAME=altere

# Disparo em massa — reduz risco de WhatsApp derrubar a sessão (~50–100 msgs rápidas).
# WHATSAPP_DELAY_ENTRE_MS=4000
# WHATSAPP_DELAY_JITTER_MS=2000
# WHATSAPP_PAUSA_LOTE_A_CADA=40
# WHATSAPP_PAUSA_LOTE_MS=30000
# WHATSAPP_CHECK_CONEXAO_A_CADA=10
# WHATSAPP_PRESENCE_DELAY_MS=1500

# CORS: só localhost/127.0.0.1. Acesso por IP da rede local = CORS_ALLOW_LAN=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_LAN=true

# Frontend (Vite) — use localhost; na LAN o cliente troca o host automaticamente
VITE_API_URL=http://localhost:8000/api/v1

WEBHOOK_PUBLIC_URL=http://backend:8000/api/v1/whatsapp/webhook
