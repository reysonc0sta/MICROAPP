# Copie para secret.yaml e preencha os valores (NÃO commite secret.yaml).
#   cp k8s/secret.yaml.example k8s/secret.yaml
# Depois:
#   kubectl apply -f k8s/secret.yaml
#
# Alternativa sem arquivo local:
#   kubectl -n microapp create secret generic microapp-secrets \
#     --from-literal=POSTGRES_PASSWORD='...' \
#     --from-literal=SECRET_KEY='...' \
#     --from-literal=EVOLUTION_API_KEY='...' \
#     --from-literal=ADMIN_EMAIL='admin@escola.com' \
#     --from-literal=ADMIN_PASSWORD='...' \
#     --from-literal=DATABASE_URL='postgresql://postgres:...@postgres:5432/microapp' \
#     --from-literal=DATABASE_CONNECTION_URI='postgresql://postgres:...@postgres:5432/evolution_db?schema=public'
apiVersion: v1
kind: Secret
metadata:
  name: microapp-secrets
  namespace: microapp
  labels:
    app.kubernetes.io/name: microapp
type: Opaque
stringData:
  POSTGRES_PASSWORD: altere_esta_senha
  SECRET_KEY: gere_uma_chave_aleatoria_longa
  EVOLUTION_API_KEY: altere_esta_chave
  ADMIN_EMAIL: admin@escola.com
  ADMIN_PASSWORD: altere_esta_senha
  # Deve usar a mesma senha de POSTGRES_PASSWORD e o Service "postgres"
  DATABASE_URL: postgresql://postgres:altere_esta_senha@postgres:5432/microapp
  DATABASE_CONNECTION_URI: postgresql://postgres:altere_esta_senha@postgres:5432/evolution_db?schema=public
